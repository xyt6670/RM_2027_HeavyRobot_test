# VS Code generated indexes and caches; keep workspace JSON settings
/.vscode/ipch/
/.vscode/.browse.c_cpp.db*
/.vscode/*.log
/MDK-ARM/.vscode/*.log*
/MDK-ARM/.vscode/*.lock

# Local backup and temporary files
/backups/
*.bak
*.tmp
*.orig
*~

# Windows/macOS metadata
Thumbs.db
Desktop.ini
.DS_Store
