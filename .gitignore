# Keil MDK build output
/Build/
/MDK-ARM/can_motor_test/
/MDK-ARM/*-build.log
/MDK-ARM/*.log
/MDK-ARM/*.lst

# Keil per-user UI state (breakpoints, window layout, recent files)
/MDK-ARM/*.uvguix.*

# ARM compiler/linker generated files
*.o
*.d
*.crf
*.axf
*.elf
*.hex
*.bin
*.map
*.lnp
*.dep
